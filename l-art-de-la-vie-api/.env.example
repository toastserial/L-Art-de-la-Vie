PORT=3000
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
STOREFRONT_ORIGIN=http://127.0.0.1:5174

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_PRIVADA
SUPABASE_STORE_ID=00000000-0000-0000-0000-000000000001

# Motor semántico principal. Solo se configura en el backend (Render).
# Nunca pongas estas credenciales en Expo/Vite ni las subas a Git.
CLOUDFLARE_ACCOUNT_ID=TU_ACCOUNT_ID_DE_CLOUDFLARE
CLOUDFLARE_API_TOKEN=TU_TOKEN_PRIVADO_DE_WORKERS_AI
# Opcional: permite cambiar de modelo sin modificar el código.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Respaldos opcionales de Google. Cloudflare funciona sin estas claves.
GOOGLE_VISION_API_KEY=TU_API_KEY_RESTRINGIDA_A_CLOUD_VISION
GEMINI_API_KEY=TU_API_KEY_DE_GOOGLE_AI_STUDIO
# Tope preventivo de la aplicación por tienda y mes.
PRODUCT_ANALYSIS_MONTHLY_LIMIT=100
